# Private operator file. Copy outside the source checkout and chmod 600.
# Set WEB_UID/WEB_GID to the deploying account's numeric id -u / id -g.
WEB_UID=1000
WEB_GID=1000
WEB_BIND_IP=10.20.30.40
WEB_PORT=18082
WEB_ORIGIN=http://10.20.30.40:18082
WEB_ALLOWED_CIDRS=10.20.30.0/24
# Existing private directory; this one dedicated file is generated by config/up.
WEB_ACCESS_FILE=/private/depositarai-intranet/intranet-allow.conf
WEB_API_KEY_FILE=/private/depositarai-intranet/api-key
WEB_UPSTREAM=https://gpu.example.org
# Optional private CA; the HTTPS hostname and certificate are always verified.
WEB_UPSTREAM_CA_FILE=
