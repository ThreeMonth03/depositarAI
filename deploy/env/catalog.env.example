# Sealed product bootstrap input; the lifecycle binds the project, paths and IDs.
# This file contains no credentials and is not a standalone deployment profile.
COMPOSE_PROJECT_NAME=depositar-ai-catalog-aaaaaaaaaaaa-bbbbbbbbbbbb

# Control/config/model files use this private path; the index uses the external
# local Docker volume named <qualified-project>-index.
SEARCH_CATALOG_DATA_ROOT=/tmp/depositar-catalog-ci
SEARCH_CATALOG_STORAGE_ALLOWED_ROOT=/tmp
SEARCH_CATALOG_STORAGE_REQUIRED_FS_TYPES=
# Product preparation binds these IDs to the invoking non-root account in the
# sealed dotenv. File-backed secrets preserve host ownership.
SEARCH_CATALOG_RUNTIME_UID=1000
SEARCH_CATALOG_RUNTIME_GID=1000
# Optional trusted, pre-populated Ollama store used only to seed the exact
# digest-verified Granite model. Empty means model preparation must be done
# explicitly before deployment.
SEARCH_CATALOG_MODEL_SOURCE=
SEARCH_FESS_BASE_IMAGE=ghcr.io/codelibs/fess:15.8.0@sha256:442a58831e87aae6ae22ef60e0536ececbda553bd5f5e8e5dc98cc022578dc75
SEARCH_OPENSEARCH_BASE_IMAGE=ghcr.io/codelibs/fess-opensearch:3.8.0@sha256:c59dd34da6d0c6e0117b8851ded0832f168de9b33e275e62cd3ef3139362d7fc
SEARCH_OLLAMA_IMAGE=ollama/ollama:0.32.14@sha256:9d30908e41144b1f1da89b9d8e33c07e4aeb43ff41a8660241b1686e2cc330ad
SEARCH_FESS_IMAGE=depositar-fess-catalog:15.8.0-local
SEARCH_OPENSEARCH_IMAGE=depositar-opensearch-catalog:3.8.0-local
SEARCH_CATALOG_ADMIN_BASE_IMAGE=python:3.13.7-slim-bookworm@sha256:adafcc17694d715c905b4c7bebd96907a1fd5cf183395f0ebc4d3428bd22d92d
SEARCH_CATALOG_ADMIN_IMAGE=depositar-search-catalog-admin:1-local

SEARCH_FESS_CPU_LIMIT=4
SEARCH_FESS_MEM_LIMIT=8G
SEARCH_FESS_PIDS_LIMIT=2048
SEARCH_OPENSEARCH_CPU_LIMIT=4
SEARCH_OPENSEARCH_MEM_LIMIT=8G
SEARCH_OPENSEARCH_PIDS_LIMIT=2048
SEARCH_OLLAMA_CPU_LIMIT=12
SEARCH_OLLAMA_MEM_LIMIT=8G
SEARCH_OLLAMA_PIDS_LIMIT=512

# One-shot catalog administration is intentionally single-threaded and shares
# Fess's network namespace. That namespace can also reach loopback Ollama and
# the internal OpenSearch address; the boundary is the fixed-endpoint client
# plus absence of backend credentials, not an egress firewall. The helper
# never receives a Docker socket or generic URL input.
SEARCH_CATALOG_ADMIN_CPU_LIMIT=1
SEARCH_CATALOG_ADMIN_MEM_LIMIT=1G
SEARCH_CATALOG_ADMIN_PIDS_LIMIT=64
