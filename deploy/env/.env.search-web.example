# CPU frontend only. Copy outside Git, use your non-root numeric UID/GID,
# and provide an existing private API service key readable by that UID.
WEB_UID=1000
WEB_GID=1000
WEB_API_KEY_FILE=/absolute/private/search-web/api_key
WEB_ORIGIN=http://127.0.0.1:18081
# An operator-approved HTTPS origin with a certificate trusted by the container.
WEB_UPSTREAM=https://private-api.example.org
# Optional PEM CA certificate/bundle for a private issuer. Leave unset for the
# existing public CA roots. Supply only public certificates, never a private key.
# WEB_UPSTREAM_CA_FILE=/absolute/private/search-web/upstream-ca.pem
